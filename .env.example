# Anthropic API key — the only thing reviewers need to run the agent.
# Leave it set for the normal (production/submission) path: the agent and the
# eval judge both bill per-token against this key.
ANTHROPIC_API_KEY=

# LOCAL DEV — run on your Claude Pro/Max subscription instead of the API:
#   1. leave ANTHROPIC_API_KEY BLANK (above)
#   2. run `claude setup-token` once and export CLAUDE_CODE_OAUTH_TOKEN,
#      OR just be logged into the Claude Code CLI
# With no API key present, the agent (Claude Agent SDK) and the eval judge both
# run on your subscription. NOTE: the deployed submission must use the API key —
# reviewers plug in their own key and don't have your subscription. Anthropic's
# Agent SDK docs also steer shipped agents to API-key auth; keep subscription
# mode to your own local testing.

# Model used by the agent (optional; defaults to claude-opus-5).
AGENT_MODEL=claude-opus-5
